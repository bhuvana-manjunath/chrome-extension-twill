{
  "manifest_version": 3,
  "name": "Twill — Quick Refer from LinkedIn",
  "description": "Refer people you know to open roles (via Twill) in seconds, right from their LinkedIn profile.",
  "version": "0.1",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "exclude_matches": [
        "https://buildwithcharles.io/404"
      ],
      "js": [
        "files/injectButton.js"
      ],
      "run_at": "document_end"
    }
  ],
  "host_permissions": [
    "https://www.linkedin.com/in/*"
  ],
  "action": {
    "default_icon": {
      "16": "images/16x16.png",
      "32": "images/32x32.png",
      "48": "images/48x48.png",
      "128": "images/128x128.png"
    }
  },
  "icons": {
    "16": "images/16x16.png",
    "32": "images/32x32.png",
    "48": "images/48x48.png",
    "128": "images/128x128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "images/128x128.png"
      ],
      "matches": [
        "https://www.linkedin.com/*"
      ]
    }
  ],
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "scripting",
    "webRequest"
  ]
}